# Raw source data - never commit
data/raw/*
!data/raw/README.md

# Processed row-level data - keep local
data/processed/*
!data/processed/README.md

# Python cache
__pycache__/
*.pyc
*.pyo

# Jupyter temporary files
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# Excel source files
*.xlsx
*.xls

# OS/editor files
.DS_Store
Thumbs.db
